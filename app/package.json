{
  "name": "resspark-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project web --project worker-node",
    "test:workerd": "vitest run --project workerd",
    "test:live": "dotenv -e .env -e .dev.vars -e ../src/frontend/.env -- vitest run --project worker-node worker/test",
    "test:rls": "dotenv -e ../src/frontend/.env -- vitest run --project worker-node worker/test/rls.test.ts",
    "test:live:file": "dotenv -e .env -e .dev.vars -e ../src/frontend/.env -- vitest run --project worker-node",
    "test:requests": "dotenv -e .env -e .dev.vars -- vitest run --project worker-node worker/test/requests-live.test.ts",
    "check": "node scripts/check-file-sizes.mjs && python ../src/tools/export_golden_fixtures.py --check && tsc -b && eslint . && pnpm test",
    "cf-typegen": "wrangler types --strict-vars=false",
    "wrangler": "dotenv -e ../.env -- wrangler",
    "deploy:raw": "vite build && wrangler deploy",
    "deploy": "dotenv -e ../.env -e ../src/frontend/.env -- pnpm run deploy:raw",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "dotenv -e .env -e .dev.vars -e ../src/frontend/.env -- node scripts/smoke.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "questions:reconcile": "node scripts/reconcile-questions.mjs",
    "secrets:provision": "dotenv -e ../.env -e ../src/frontend/.env -- node scripts/provision-secrets.mjs",
    "secrets:provider": "dotenv -e ../.env -e ../src/frontend/.env -- node scripts/provision-secrets.mjs --provider",
    "staff:create": "dotenv -e .dev.vars -- node scripts/create-staff.mjs",
    "auth:config-push": "node scripts/supabase-config-push.mjs",
    "spike": "dotenv -e .dev.vars -- node"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@docuseal/react": "1.0.75",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-direction": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query": "5.99.0",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "heic2any": "0.0.4",
    "hono": "4.13.13",
    "input-otp": "1.4.2",
    "jose": "6.2.12",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "react-top-loading-bar": "3.0.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint/js": "10.0.1",
    "@tanstack/eslint-plugin-query": "5.99.0",
    "@tanstack/react-query-devtools": "5.99.0",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/router-plugin": "1.167.22",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "dotenv-cli": "11.0.0",
    "eslint": "10.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "jsdom": "29.0.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2",
    "vite": "8.0.8",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}

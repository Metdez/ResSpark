{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resspark",
  "account_id": "a16da3bffdeb782c36d0e28382a9b25b",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // "directory" is omitted on purpose: @cloudflare/vite-plugin points it at the client build
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/c/*"]
  },
  "vars": {
    "APP_ENV": "sandbox",
    "LOGICS_WRITE_ENABLED": "false",
    "LOGICS_TEST_CASE_IDS": "",
    // "fake" serves fixture cases (C1); "live" after Settings → Integrations → Test connection succeeds.
    // Live since 2026-10-11 for reads (user request); writes stay refused while LOGICS_WRITE_ENABLED is "false".
    "LOGICS_MODE": "live",
    // Cloudflare Email Service sender. Empty = email off ("not configured"). It must be on a domain onboarded in
    // Compute > Email Service > Email Sending; until resspark.com is registered and onboarded, sends report "not configured".
    "EMAIL_FROM": "notifications@resspark.com",
    // Phase 4 (D-15). Vendor keys are optional secrets, set with `pnpm -C app secrets:provider plaid|truv`
    "PLAID_ENV": "sandbox",
    "TRUV_TEMPLATE_ID": "",
    "PLAID_REMOVE_AFTER_DAYS": "30",
    "BANK_PROVIDER": "plaid",
    // Phase 6 (D-10). DOCUSEAL_* and SMARTY_* keys are optional secrets: `pnpm -C app secrets:provider docuseal|smarty`
    "DOCUSEAL_API_URL": "https://api.docuseal.com",
    "DOCUSEAL_ENV": "test"
  },
  // Deploy fails if any of these is not set on the Worker (D-07); values come from provision-secrets.mjs.
  // PLAID_* and TRUV_* stay out on purpose: without them the portal falls back to manual upload (D-15).
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_SECRET_KEY", "CLIENT_LINK_HMAC_KEY", "INTEGRATION_ENC_KEY", "TOKEN_ENC_KEY_1"]
  },
  // Cloudflare Email Service (Workers Paid): client-link, invite and password-reset emails (cloudflare-email.ts)
  "send_email": [{ "name": "EMAIL" }],
  // Per-ip throttle on /c/:token guessing (D-18); link-rate-limit.ts falls back to memory without it
  "ratelimits": [
    { "name": "LINK_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": {
    // 15-minute reconciler and the 03:00 UTC Item-removal step (cron.ts branches on controller.cron)
    "crons": ["*/15 * * * *", "0 3 * * *"]
  },
  "queues": {
    "producers": [{ "queue": "resspark-jobs", "binding": "JOBS" }],
    "consumers": [
      {
        "queue": "resspark-jobs",
        "max_batch_size": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "resspark-jobs-dlq",
        "max_concurrency": 3
      },
      // Records dead-lettered jobs (jobs/index.ts DLQ branch); never retried
      {
        "queue": "resspark-jobs-dlq",
        "max_batch_size": 10,
        "max_retries": 0
      }
    ]
  },
  "observability": {
    "enabled": true,
    // Platform invocation logs record the request URL; off so /c/<token> is never stored (PLAT-08)
    "logs": { "invocation_logs": false }
  }
}

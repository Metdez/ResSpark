{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resspark",
  "account_id": "a16da3bffdeb782c36d0e28382a9b25b",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // "directory" is omitted on purpose: @cloudflare/vite-plugin points it at the client build
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/c/*"]
  },
  "vars": {
    "APP_ENV": "sandbox",
    "LOGICS_WRITE_ENABLED": "false",
    "LOGICS_TEST_CASE_IDS": "",
    // "fake" serves fixture cases (C1); "live" after Settings → Integrations → Test connection succeeds
    "LOGICS_MODE": "fake",
    // Resend delivers only to the account owner until a domain is verified (D-09)
    "RESEND_FROM": "onboarding@resend.dev"
  },
  // Deploy fails if any of these is not set on the Worker (D-07); values come from provision-secrets.mjs
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_SECRET_KEY", "CLIENT_LINK_HMAC_KEY", "INTEGRATION_ENC_KEY"]
  },
  // Per-ip throttle on /c/:token guessing (D-18); link-rate-limit.ts falls back to memory without it
  "ratelimits": [
    { "name": "LINK_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "queues": {
    "producers": [{ "queue": "resspark-jobs", "binding": "JOBS" }],
    "consumers": [
      {
        "queue": "resspark-jobs",
        "max_batch_size": 1,
        "max_retries": 8,
        "dead_letter_queue": "resspark-jobs-dlq",
        "max_concurrency": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    // Platform invocation logs record the request URL; off so /c/<token> is never stored (PLAT-08)
    "logs": { "invocation_logs": false }
  }
}

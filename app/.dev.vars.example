# Copy to app/.dev.vars (git-ignored). pnpm -C app secrets:provision and staff:create fill it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CLIENT_LINK_HMAC_KEY=
INTEGRATION_ENC_KEY=
SUPABASE_PUBLISHABLE_KEY=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
# STAFF_PASSWORD__<email with @ and . as _>=   one per created staff user
TOKEN_ENC_KEY_1=
# Phase 4 vendor keys (optional): pnpm -C app secrets:provider plaid|truv fills them
PLAID_CLIENT_ID=
PLAID_SECRET=
TRUV_CLIENT_ID=
TRUV_SECRET=
# Phase 6 vendor keys (optional): pnpm -C app secrets:provider docuseal|smarty fills them
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Logics credentials are not env vars: each firm pastes them in Settings -> Integrations (stored
# encrypted in firm_integrations). The old names stay reserved and unused:
# LOGICS_API_KEY=
# LOGICS_SECRET_TOKEN=
# Local override of the wrangler.jsonc var (keep fake; live is a USER ACTION, docs/app/logics-live-switch.md):
# LOGICS_MODE=fake
# Email goes through the Cloudflare Email Service binding (EMAIL in wrangler.jsonc); no API key.
# EMAIL_FROM=   a wrangler.jsonc var in production; set here only to override locally
